# The user's global ~/.npmrc points `cache`/`prefix` at D:\os9\..., and D: is
# 100% full — a plain `npm install` then dies with ENOSPC. This project-local
# override redirects the cache to a writable location so installs succeed for
# every contributor on this machine.
#
# CI / QA equivalent:
#   npm install --cache "C:/Users/ai9/.workbuddy-ai/cache/npm"
cache=C:/Users/ai9/.workbuddy-ai/cache/npm
